# HTTP-referrer-restricted browser key for Maps JavaScript API only.
# Copy this file to .env.local and fill in the key. .env.local is ignored by git.
VITE_GOOGLE_MAPS_API_KEY=

# Vite development proxy target, not a VITE_ browser setting.
JPASS_API_TARGET=http://127.0.0.1:8000

# Public API base including /api; embedded at build time. Empty uses /api.
# Static hosting example: https://api.example.com/api (use your real HTTPS backend).
# This is a URL, never a server API key. Rebuild after changing it.
VITE_API_BASE=
