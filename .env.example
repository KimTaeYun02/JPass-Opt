# Runtime settings for Docker Compose. Copy to .env if it does not exist.
# Empty keys allow startup and route optimization; search/recommend return 503.
GOOGLE_PLACE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Override the default model for the nearby recommendation API.
GEMINI_NEARBY_MODEL=gemini-3.5-flash-lite

# Browser origins allowed to call the API; use the actual frontend URL in deployment.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Host port for Docker Compose. The container always listens on port 8000.
API_PORT=8000
