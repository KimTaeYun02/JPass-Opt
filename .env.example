# Runtime settings for Docker Compose. Copy to .env if it does not exist.
# Places/Gemini keys and GEMINI_MODEL are required; blank values prevent startup.
GOOGLE_PLACE_API_KEY=
# Optional: enable Routes API and restrict this server key to Routes API + server IPs.
# Required only for requests with includeAccessWalking=true and at least two places.
GOOGLE_ROUTES_API_KEY=
GEMINI_API_KEY=
# Required default model, validated at application startup.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional override for nearby recommendations; blank uses GEMINI_MODEL.
GEMINI_NEARBY_MODEL=gemini-3.5-flash-lite

# Browser origins allowed to call the API; use the actual frontend URL in deployment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Host port for Docker Compose. The container always listens on port 8000.
API_PORT=8000
