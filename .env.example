# Runtime settings for Docker Compose. Copy to .env if it does not exist.
# Google Places and the selected LLM provider's API key are required.
GOOGLE_PLACE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Default model for requests without an override.
OPENAI_MODEL=gemini-3.5-flash-lite
# Optional nearby model (GPT or Gemini); blank uses OPENAI_MODEL.
LLM_NEARBY_MODEL=

# Browser origins allowed to call the API; use the actual frontend URL in deployment.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Host port for Docker Compose. The container always listens on port 8000.
API_PORT=8000
